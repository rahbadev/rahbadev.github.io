{
    "name": "first-store",
    "version": "1.0.0",
    "description": "متجر إلكتروني احترافي بسيط مع لوحة تحكم - Professional Simple E-commerce Store with Admin Panel",
    "author": "RehbaDev",
    "license": "MIT",
    "keywords": [
        "ecommerce",
        "store",
        "shop",
        "supabase",
        "cloudinary",
        "alpine.js",
        "tailwindcss",
        "متجر",
        "متجر-إلكتروني"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/first-store.git"
    },
    "scripts": {
        "dev": "echo 'افتح index.html في المتصفح مباشرة - Open index.html in browser'",
        "admin": "echo 'افتح admin.html في المتصفح - Open admin.html in browser'",
        "deploy": "echo 'راجع DEPLOYMENT.md لطرق النشر - Check DEPLOYMENT.md for deployment options'"
    },
    "dependencies": {},
    "devDependencies": {},
    "engines": {
        "node": ">=14.0.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
    "config": {
        "note": "هذا المشروع لا يحتاج npm dependencies - كل المكتبات محملة من CDN",
        "cdn-libraries": [
            "Alpine.js 3.13.3",
            "Tailwind CSS 3.4.1",
            "Supabase JS 2.39.0",
            "Compressor.js 1.2.1",
            "Toastify.js"
        ]
    },
    "features": [
        "Multi-image upload (up to 3 per product)",
        "WebP compression (75% quality)",
        "Drag & drop image upload",
        "Real-time search and filtering",
        "Responsive design (mobile-first)",
        "WhatsApp integration",
        "Toast notifications",
        "Theme customization system",
        "RTL Support (Arabic)",
        "Lazy loading images",
        "Professional admin panel",
        "Supabase backend",
        "Cloudinary image hosting"
    ],
    "structure": {
        "index.html": "صفحة المتجر الرئيسية - Main store page",
        "admin.html": "لوحة التحكم - Admin dashboard",
        "theme-config.js": "إعدادات المتجر القابلة للتخصيص - Customizable theme configuration",
        "assets/js/utils.js": "دوال مساعدة - Utility functions",
        "assets/js/database.js": "طبقة الوصول للبيانات - Data access layer",
        "database-setup.sql": "سكريبت إعداد قاعدة البيانات - Database setup script",
        "README.md": "الدليل الشامل - Comprehensive guide",
        "QUICKSTART.md": "دليل الإعداد السريع - Quick start guide",
        "DEPLOYMENT.md": "دليل النشر - Deployment guide",
        "CHANGELOG.md": "سجل التغييرات - Change log"
    },
    "tech-stack": {
        "frontend": {
            "framework": "Alpine.js 3.x",
            "css": "Tailwind CSS 3.x",
            "javascript": "Vanilla JS ES6+"
        },
        "backend": {
            "database": "Supabase (PostgreSQL)",
            "storage": "Cloudinary",
            "authentication": "Supabase Auth (optional)"
        },
        "libraries": {
            "image-compression": "Compressor.js",
            "notifications": "Toastify.js"
        }
    },
    "setup-time": "5 minutes (see QUICKSTART.md)",
    "deployment-options": [
        "Netlify (recommended)",
        "Vercel",
        "GitHub Pages",
        "Cloudflare Pages",
        "Traditional Hosting (cPanel)"
    ],
    "requirements": {
        "supabase-account": "مجاني - Free at supabase.com",
        "cloudinary-account": "مجاني - Free at cloudinary.com",
        "nodejs": "غير مطلوب للتشغيل - Not required for runtime",
        "build-tools": "لا يوجد - None (Static site)"
    },
    "customization": {
        "colors": "theme-config.js > themeColors",
        "fonts": "theme-config.js > themeFonts",
        "store-info": "theme-config.js > storeInfo",
        "contact": "theme-config.js > storeInfo.contact"
    },
    "performance": {
        "image-format": "WebP (75% quality)",
        "image-max-size": "1200px",
        "lazy-loading": "Enabled",
        "cdn": "All libraries from CDN",
        "bundle-size": "~50KB (excluding images)"
    },
    "browser-support": {
        "chrome": ">= 90",
        "firefox": ">= 88",
        "safari": ">= 14",
        "edge": ">= 90",
        "mobile": "iOS Safari >= 14, Chrome Android >= 90"
    },
    "documentation": {
        "full-guide": "README.md",
        "quick-setup": "QUICKSTART.md",
        "deployment": "DEPLOYMENT.md",
        "changelog": "CHANGELOG.md"
    },
    "support": {
        "email": "support@example.com",
        "whatsapp": "+966500000000",
        "website": "https://example.com"
    }
}